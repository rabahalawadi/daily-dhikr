# ==============================================================================
# Daily Dhikr Automation - Environment Configuration
# ==============================================================================

# Database Configuration
# Local SQLite default: sqlite:///./daily_dhikr.db
# PostgreSQL / Supabase: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./daily_dhikr.db

# Timezone (Used for daily prayer & reminder scheduling)
# Standard IANA timezone string. Example: Asia/Amman, Asia/Riyadh, UTC
TIMEZONE=Asia/Amman

# Safety Switches (CRITICAL FOR FIRST DEPLOYMENT)
# DRY_RUN: When true, images are rendered and validated but no real API calls are sent to Instagram.
DRY_RUN=true
# PUBLISHING_ENABLED: Global master kill-switch. Must be explicitly set to true to publish live.
PUBLISHING_ENABLED=false

# Meta / Instagram Graph API Configuration
# Required permissions: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=your_long_lived_meta_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_or_creator_account_id_here
INSTAGRAM_API_VERSION=v21.0

# Persistent Media Storage Backend ('local', 'supabase', or 's3')
# Instagram Graph API requires public, accessible URLs to download images for containers.
STORAGE_BACKEND=local
# If using Supabase Storage or S3:
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
STORAGE_BUCKET=dhikr-media
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_PUBLIC_URL_PREFIX=https://your-project.supabase.co/storage/v1/object/public/dhikr-media

# Notification & Alerting Webhook (Discord / Slack / Telegram / Custom webhook)
NOTIFICATION_WEBHOOK_URL=

# Email Alerts (Optional SMTP)
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_RECIPIENT=

# Admin Dashboard
ADMIN_API_KEY=
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
